{
  "manifest_version": 3,
  "name": "Reels Digest",
  "version": "0.6.0",
  "minimum_chrome_version": "120",
  "description": "Capture Instagram reels to your local digest, with optional user-started fixed-interval auto-scroll.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": [
        "selectors.js",
        "frame.js",
        "content.js",
        "autoscroll.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Reels Digest \u2014 auto-scroll controls",
    "default_popup": "popup.html"
  }
}
